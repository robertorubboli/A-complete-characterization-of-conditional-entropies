digraph FormalizationLayers {
  graph [rankdir=TB, bgcolor="white", pad=0.20, nodesep=0.35,
         ranksep=0.55, splines=polyline, newrank=true,
         fontname="Arial", fontsize=18,
         label="Lean formalization dependency layers", labelloc=t];
  node [shape=box, style="rounded,filled", penwidth=1.2,
        fontname="Arial", fontsize=11, margin="0.16,0.10",
        width=3.15];
  edge [color="#6b7280", penwidth=1.0, arrowsize=0.65];

  m1 [label="M1  Finite carriers, cones,\nand channels\nPARTIAL",
      fillcolor="#eff6ff", color="#2563eb"];
  m2 [label="M2  Compact parameters, measures,\nsupport, and moments\nOPEN",
      fillcolor="#fff7ed", color="#ea580c"];
  m3 [label="M3  Total endpoint-aware\nRenyi library\nOPEN",
      fillcolor="#fff7ed", color="#ea580c"];
  m4 [label="M4  Conditional candidates\nand shape reductions\nPARTIAL",
      fillcolor="#eff6ff", color="#2563eb"];
  m5 [label="M5  Temperate sufficiency\nPARTIAL ALGEBRAIC KERNELS",
      fillcolor="#eff6ff", color="#2563eb"];
  m6 [label="M6  Tropical and derivation\nsufficiency\nOPEN",
      fillcolor="#fff7ed", color="#ea580c"];
  m7 [label="M7  Differentiation and\nsigned integration\nPARTIAL STATIONARITY KERNELS",
      fillcolor="#eff6ff", color="#2563eb"];
  m8 [label="M8  Two- and three-block\nlocalization\nPARTIAL DOMINANT-BLOCK BOUNDS",
      fillcolor="#eff6ff", color="#2563eb"];
  m9 [label="M9  Shannon-point localization\nOPEN",
      fillcolor="#fff7ed", color="#ea580c"];
  m10 [label="M10  Necessity branches\nPARTIAL SCALAR KERNELS",
       fillcolor="#eff6ff", color="#2563eb"];
  m11 [label="M11  Classification and\nembedded-axiom lift\nOPEN",
       fillcolor="#fff7ed", color="#ea580c"];

  { rank=same; m1; m2 }
  { rank=same; m5; m7 }
  { rank=same; m6; m8 }

  m1 -> m3;
  m2 -> m3;
  m1 -> m4;
  m2 -> m4;
  m3 -> m4;

  m2 -> m5;
  m3 -> m5;
  m4 -> m5;
  m3 -> m6;
  m4 -> m6;
  m5 -> m6;

  m2 -> m7;
  m3 -> m7;
  m4 -> m7;
  m1 -> m8;
  m2 -> m8;
  m3 -> m8;
  m7 -> m8;
  m7 -> m9;
  m8 -> m9;

  m4 -> m10;
  m7 -> m10;
  m8 -> m10;
  m9 -> m10;

  m4 -> m11;
  m5 -> m11;
  m6 -> m11;
  m10 -> m11;
}
